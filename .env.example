# Set your own Discord credentials locally. Do not commit .env.
DISCORD_USAGE_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
# Required: comma-separated Discord user IDs allowed to run commands.
DISCORD_ALLOWED_USER_IDS=
# Optional additional channel restriction for the allowed users.
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_BOT_NAME=Your_LLM_Bot
DISCORD_WORK_WEBHOOK_URL=
CLAUDE_PLAN=pro
CLAUDE_5H_TOKEN_LIMIT=
AI_USAGE_LANGUAGE=auto
AI_USAGE_TIMEZONE=auto
WORK_MONITOR_ENABLED=1
WORK_MONITOR_INTERVAL_SECONDS=30
WORK_IDLE_SECONDS=600
WORK_INCLUDE_SUMMARY=0
WORK_COMPLETION_COOLDOWN_SECONDS=3600
WORK_PROVIDER_COMPLETION_COOLDOWN_SECONDS=300
RESUME_QUEUE_ENABLED=0
RESUME_QUEUE_INTERVAL_SECONDS=60
